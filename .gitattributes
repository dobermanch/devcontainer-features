# Everything here runs inside Linux containers: keep LF on every checkout,
# including Windows with core.autocrlf, or the scripts fail with "\r" errors.
* text=auto eol=lf

*.sh                 text eol=lf
scripts/devcontainer text eol=lf
Makefile             text eol=lf
*.json               text eol=lf linguist-language=JSON-with-Comments
*.md                 text eol=lf

*.png binary
*.jpg binary
